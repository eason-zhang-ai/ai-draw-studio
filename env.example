# ============================================================
# AI 智能绘图 —— 环境变量模板
#
# 本地开发：cp env.example .env.local   然后填写（Next.js 读取 .env.local）
# Docker 部署：配在 docker-compose.yaml 的 environment，或用 1Panel
#   编排的「环境变量」标签页（1Panel 会把它们写进项目根目录的 .env）。
#
# AI_* 是服务端「运行时」变量：改完重启容器即可，无需重建镜像。
# 本项目不使用 NEXT_PUBLIC_*（那类变量在构建时就被内联进浏览器包，
# 运行时修改无效）。
# ============================================================

# ---- 模型服务（必填）----
# OpenAI 兼容端点
AI_BASE_URL="https://code-api.erix.vip/v1"
# 端点密钥
AI_API_KEY="your-api-key-here"
# 默认模型：绘图与图片输入共用同一个模型
# （该模型是否支持图片，由前端「模型支持图片输入」勾选决定）
AI_MODEL="deepseek-v4-flash"

# ---- 生成参数（可选）----
# 最大输出 token。留空 = 不发送 max_tokens，使用模型默认上限
# （该端点实测上限 [1, 393216]）。前端表单可覆盖。
AI_MAX_OUTPUT_TOKENS="384000"

# 输入上下文预算（token，粗略估算）。留空 = 不裁剪输入，用模型默认窗口
# （该端点实测窗口 ≥ 250K）。设置后按预算裁剪历史消息/图表上下文。
# 前端表单可覆盖。
# AI_CONTEXT_LENGTH="64000"

# 思考等级：none | minimal | low | medium | high
# 留空 = 不发送 reasoning_effort，沿用端点默认（思考量最大）。
# 直连网关实测：reasoning_effort=none 可把 reasoning_tokens 压到 0；
# 其他写法（thinking / enable_thinking / thinking_budget）会被静默忽略。
AI_THINKING_LEVEL=""

# 默认模型是否支持图片输入（vision）：true / false，留空 = 视为 false。
# 这是前端「模型支持图片输入」开关的服务端默认值 —— 前端未显式设置时用它。
AI_MODEL_SUPPORTS_VISION="false"

# 画布渐进绘制动画：true（默认）/ false。
# 纯前端行为：模型仍是一次性返回完整场景，前端分批上屏，因此不消耗额外 token。
# 目前作用于 Excalidraw 面板；设为 false 可关闭动画、瞬间呈现结果。
AI_PROGRESSIVE_DRAW="true"

# ---- 预览渲染后端（可选）----
# 覆盖 PlantUML / Kroki 预览所用的渲染服务
# PLANTUML_RENDER_BASE="https://your-internal-host/plantuml/svg"
# KROKI_RENDER_BASE="https://your-internal-host-or-alternative-kroki-instance"

# ---- 旧版变量（仍作为兜底，一般无需设置）----
# AI_BASE_URL 未设置时回退 OPENAI_BASE_URL，AI_API_KEY 回退 OPENAI_API_KEY，
# AI_MODEL 回退 OPENAI_MODEL，AI_MAX_OUTPUT_TOKENS 回退 OPENAI_MAX_OUTPUT_TOKENS。
# OPENAI_API_KEY="your-openai-api-key-here"
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MAX_OUTPUT_TOKENS="16000"
