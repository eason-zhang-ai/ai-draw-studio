# DeepSeek V4 系列（OpenAI 兼容端点，默认：Erix 网关）
AI_BASE_URL="https://code-api.erix.vip/v1"
AI_API_KEY="your-api-key-here"
AI_MODEL="deepseek-v4-flash"
AI_VISION_MODEL="deepseek-v4-flash-vision-exp"
# Optional: raise if the provider allows larger responses
# AI_MAX_OUTPUT_TOKENS="16000"

# Client-side defaults (baked at build time; keep in sync with the above)
NEXT_PUBLIC_AI_BASE_URL="https://code-api.erix.vip/v1"
NEXT_PUBLIC_AI_VISION_MODEL="deepseek-v4-flash-vision-exp"

# ---- Legacy upstream vars (still honored as fallbacks) ----
# OpenAI credentials used on the server (front-end UI can override per browser)
# OPENAI_API_KEY="your-openai-api-key-here"
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MAX_OUTPUT_TOKENS="16000"

# Optional: override the PlantUML renderer used for previews
# PLANTUML_RENDER_BASE="https://your-internal-host/plantuml/svg"

# Optional: override the Kroki renderer used for previews (defaults to https://kroki.io)
# KROKI_RENDER_BASE="https://your-internal-host-or-alternative-kroki-instance"
